# Leave empty to use the same origin (Vite proxies /api during development).
# For a separate API origin, use its root URL WITHOUT /api; backend CORS is required.
VITE_API_URL=
# Development proxy target: Spring Boot root URL.
API_PROXY_TARGET=http://localhost:8080
# ProductResponse has no currency: set these to the business configuration.
VITE_CURRENCY=COP
VITE_LOCALE=es-CO
